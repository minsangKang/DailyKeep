// Daily Keep 환경변수 — 이 파일 하나에서 모든 값을 관리합니다.
// 사용법: cp Config/Env.example.xcconfig Config/Env.xcconfig 후 값을 채우고 `make generate`
// 주의: xcconfig는 `//` 뒤를 주석으로 읽습니다. URL은 넣지 마세요.

// ── 서명 · iCloud ───────────────────────────────
// Apple Developer Team ID (developer.apple.com → Membership)
DEVELOPMENT_TEAM =
DK_BUNDLE_ID = com.klab.dailykeep
// YES면 SwiftData를 iCloud(CloudKit private DB)와 동기화합니다. NO면 기기 내부에만 저장합니다.
ICLOUD_ENABLED = YES
ICLOUD_CONTAINER = iCloud.com.klab.dailykeep

// ── AI ─────────────────────────────────────────
// ondevice | gemini — 앱 설정에서 바꾸기 전의 기본값
AI_DEFAULT_PROVIDER = ondevice
GEMINI_API_KEY =
GEMINI_MODEL = gemini-3.8-flash
